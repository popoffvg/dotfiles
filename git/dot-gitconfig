[interactive]
    diffFilter = hunk diff

[merge]
    conflictstyle = diff3
[merge "mergiraf"]
    name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[push]
    autoSetupRemote = true # create remote branch auto
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
[url "git@gitlab.com:"]
	insteadOf = https://gitlab.com/
[user]
	email = popoffvg@gmail.com
	name = Vitalii Popov

[alias]
	task = !~/task.sh
	traverse = !~/traverse.sh
	show = !~/show.sh
	ch = !~/ch.sh
	find = !~/branch_find.sh
	fdiff = !~/fd.sh
    test = !git diff \"$@\"
	ia = !git status --short | fzf -m --nth 2.. --preview \"git diff HEAD --color=always -- {-1}\" | cut -c4- | xargs -r git add
	add-interactive = !git ia
	review = !~/local/bin/git-agent-review
	append = town append
	hack = town hack
	sync = town sync
    st = status
    a = !git add .
    fp = !git add . && git commit --amend --no-edit && git push -f
    pr-diff = !git diff "$(git merge-base --fork-point "$(git show-ref --verify --quiet refs/heads/main && echo main || echo master)")"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	pager = hunk pager
	excludesfile = ~/.gitignore
# The token of the gh account named in username; a folder include changes the username.
[credential "https://github.com"]
	username = popoffvg
	helper =
	helper = "!f() { [ \"$1\" = get ] || exit 0; u=$(sed -n 's/^username=//p'); [ -n \"$u\" ] || exit 0; t=$(/opt/nanobrew/prefix/bin/gh auth token --user \"$u\") || exit 0; printf 'username=%s\\npassword=%s\\n' \"$u\" \"$t\"; }; f"
[credential "https://gist.github.com"]
	username = popoffvg
	helper =
	helper = "!f() { [ \"$1\" = get ] || exit 0; u=$(sed -n 's/^username=//p'); [ -n \"$u\" ] || exit 0; t=$(/opt/nanobrew/prefix/bin/gh auth token --user \"$u\") || exit 0; printf 'username=%s\\npassword=%s\\n' \"$u\" \"$t\"; }; f"
[safe]
	directory = *
[pager]
	log = less -FRX
# Folder includes stay last: a later value overrides [user] and [core] above.
[includeIf "gitdir:~/Documents/git/inDrive/"]
  path = ~/Documents/git/inDrive/.gitconfig
[includeIf "gitdir:~/Documents/git/emcd/"]
  path = ~/Documents/git/emcd/.gitconfig
[includeIf "gitdir:~/Documents/git/mil/"]
  path = ~/Documents/git/mil/.gitconfig
[includeIf "gitdir:~/git/mil/"]
  path = ~/Documents/git/mil/.gitconfig
[includeIf "gitdir:~/git/mil/"]
  path = ~/.config/git/mil-hooks/gitconfig
