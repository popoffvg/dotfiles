# Aliases (fish-style, edit this file to add more)
# nanobrew for package ops; real brew keeps introspection working (--prefix/shellenv/config),
# else plugins that run `$(brew --prefix)` get nb's help text (nb exits 0 on unknown cmds → poisons $fpath).
brew() {
  case "$1" in
    -*|shellenv|config|tap|commands|home) command brew "$@" ;;
    *) nb "$@" ;;
  esac
}
