handoff-todo() {
  local root slug
  root=$(git rev-parse --show-toplevel) || return 1

  local todos_dir="$root/.notes/todos"
  local todo_id="$1"

  if [[ -n "$todo_id" ]]; then
    : # use explicit arg
  elif [[ -d "$todos_dir" ]]; then
    if ! command -v fzf >/dev/null 2>&1; then
      echo "fzf required" >&2
      return 1
    fi
    todo_id=$(ls "$todos_dir" | fzf --prompt 'TODO> ' --height 40%)
    [[ -z "$todo_id" ]] && return 0
    todo_id="${todo_id%.md}"
  else
    echo "Usage: handoff-todo <TODO-N>" >&2
    return 1
  fi

  slug=$(git rev-parse --abbrev-ref HEAD | tr '/' '-')

  local branch="$slug/$todo_id"
  local wtslug=$(echo "$todo_id" | tr '/' '-')
  local wt="$root/../$(basename "$root")-$slug-$wtslug"

  if git worktree list --porcelain | grep -qx "worktree $wt"; then
    echo "[handoff-todo] Switching to existing worktree: $wt"
  else
    git worktree add "$wt" -b "$branch" HEAD || return 1
    echo "[handoff-todo] Created worktree: $wt ($branch)"
  fi



  cd "$wt" || return 1
  command zed "$wt"
}

# prx — review a PR in hunk, in a throwaway worktree. Usage: prx <PR-url|PR-number>
# Fetches the PR base and head, opens `hunk diff base...head` (blocks until you
# quit hunk), then removes the worktree and the refs it fetched.
#
# The fetch goes straight to an authenticated HTTPS URL, not through `origin` or
# `gh pr checkout`. Two reasons: SSH auths as the personal account, which cannot
# read org repos, and the global url."git@github.com:".insteadOf rule turns every
# github.com HTTPS URL back into SSH. Credentials in front of the host make the
# URL match no insteadOf rule, so nothing rewrites it. The token is visible in
# `ps` for the length of the fetch.
#
# hunk owns the review: `c` notes a line, `T` lists the PR's existing threads, and
# `S` submits every note as one atomic GitHub review (hunk-gh-review). The `prx`
# skill writes into the same session with `hunk session comment apply`.
#
# Notes taken but not submitted are not lost: the review-focus extension mirrors
# them to a store keyed by the PR, and the next `prx <same-pr>` restores them.
#
# Before opening hunk, files that already carry unresolved review comments are
# marked with the `review-focus` extension (harness/apps/review-focus), so the
# "Start here" half of the files pane and the file order lead with what earlier reviewers already
# flagged. Marks are cleared again once hunk exits — they are worktree-scoped
# and the worktree does not survive this call.
prx() {
  emulate -L zsh -o extended_glob
  local arg="$1" nwo num
  [[ -z "$arg" ]] && { echo 'Usage: prx <PR-url|PR-number>'; return 1; }

  if [[ "$arg" == (#b)http(|s)://github.com/([^/]##/[^/]##)/pull/([0-9]##)(|/*) ]]; then
    nwo="${match[2]}"; num="${match[3]}"
  elif [[ "$arg" == [0-9]## ]]; then
    nwo=$(gh repo view --json nameWithOwner --jq .nameWithOwner) || return 1
    num="$arg"
  else
    echo "prx: not a PR url or number: $arg"; return 1
  fi

  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo 'prx: run it inside a git repo — the worktree branches off the local one'
    return 1
  }

  local base token
  base=$(gh pr view "$num" -R "$nwo" --json baseRefName --jq .baseRefName) || return 1
  token=$(gh auth token) || return 1

  local head_ref="refs/prx/$num/head" base_ref="refs/prx/$num/base"
  local wt
  wt=$(mktemp -d "${TMPDIR:-/tmp}/prx.XXXXXX") || return 1
  git worktree add --detach "$wt" HEAD || return 1

  if ! git -C "$wt" fetch --no-tags --force \
        "https://x-access-token:${token}@github.com/${nwo}.git" \
        "pull/${num}/head:$head_ref" "refs/heads/${base}:$base_ref" ||
     ! git -C "$wt" checkout --detach "$head_ref"; then
    _prx_drop "$wt" "$head_ref" "$base_ref"
    return 1
  fi

  echo "prx: ${nwo}#${num} onto ${base} — $(git -C "$wt" log --oneline -1)"

  local review_key="${nwo}#${num}"
  _prx_rank_files "$wt" "$base_ref" "$review_key"
  _prx_restore_comments "$review_key" "$wt" "$nwo" "$num"

  # The worktree is detached, so hunk-gh-review cannot resolve the PR from a checked-out
  # branch. GH_PR_NUMBER/GH_PR_REPO are its documented answer for exactly that, and `S`
  # confirms the number and title before it posts anything.
  (
    cd "$wt" &&
      PRX_REVIEW_KEY="$review_key" GH_PR_NUMBER="$num" GH_PR_REPO="$nwo" \
        command hunk diff "$base_ref...HEAD"
  )
  # No `focus clear` here. Marks are keyed on the worktree path, and `_prx_drop` deletes that
  # worktree on the next line, so the clear only ever destroyed state that was already going
  # away — while making a reopened review look like its ranking had been lost.
  _prx_drop "$wt" "$head_ref" "$base_ref"
  _prx_report_kept "$review_key" "$num"
}

_PRX_COMMENTS="$HOME/.claude/scripts/prx-comments.sh"

# Notes taken in the session outlive the worktree, because the review-focus extension mirrors
# them to a store keyed by the PR. Put them back, minus the ones the PR already carries —
# `S` clears what it submits, but a review posted from the web UI or another machine would
# otherwise come back as a duplicate.
_prx_restore_comments() {
  local key="$1" wt="$2" nwo="$3" num="$4"
  [[ -x "$_PRX_COMMENTS" ]] || return 0
  "$_PRX_COMMENTS" prune "$key" "$nwo" "$num"
  ( "$_PRX_COMMENTS" restore "$key" "$wt" ) &!
}

_prx_report_kept() {
  local key="$1" num="$2" pending
  [[ -x "$_PRX_COMMENTS" ]] || return 0
  pending=$("$_PRX_COMMENTS" count "$key") || return 0
  (( pending > 0 )) &&
    echo "prx: ${pending} note(s) not submitted — \`prx ${num}\` restores them, \`S\` posts them"
  return 0
}

# Fill the review-focus "Start here" pane before the TUI opens: `hunk focus generate`
# hands the agent the PR's changed paths and their +/- counts, and the agent answers with
# the files worth reading first and why. It runs here rather than inside the session
# because marks are read once, when a review loads.
#
# Earlier reviewers' comments are deliberately not what fills this pane. A PR comment is
# already reachable in the TUI with `T`, and pasting them here filled Start here with bot
# markup instead of a reading order. Best-effort: the agent failing must never block
# opening the review, so a failure only prints and marking is skipped.
_prx_rank_files() {
  local wt="$1" base_ref="$2" review_key="$3" ranked
  # PRX_REVIEW_KEY is what makes the ranking cacheable: without it the extension keys the
  # answer on the worktree path, which is a fresh temp directory every run, so the same pull
  # request would pay for the agent again on every open.
  echo "prx: ranking the diff — reused when this PR was already ranked at this commit"
  if ! ( cd "$wt" && PRX_REVIEW_KEY="$review_key" command hunk focus generate "${base_ref}...HEAD" ); then
    echo "prx: no ranking — Start here opens empty (ctrl+b for the plain file list)"
    return 0
  fi
  # The count is what tells the operator whether the pane will have anything in it, before
  # the TUI takes the screen and an empty pane becomes indistinguishable from a broken one.
  ranked=$( ( cd "$wt" && PRX_REVIEW_KEY="$review_key" command hunk focus list ) 2>/dev/null | grep -c . )
  echo "prx: ${ranked} file(s) in Start here — opening hunk"
  return 0
}

# Undo one prx run: the worktree and the two refs its fetch wrote.
_prx_drop() {
  git worktree remove --force "$1"
  git update-ref -d "$2"
  git update-ref -d "$3"
}

# escape — edit text in helix, print its raw contents on close.
# Usage: VAR=$(escape)   or   llm "$(escape)"   (NOT `escape | llm` — claude -p
# times out waiting on stdin while you edit; command substitution finishes first)
escape() {
  local tmp
  tmp=$(mktemp -t escape.XXXXXX) || return 1
  hx "$tmp" >/dev/tty 2>&1
  printf '%s' "$(< "$tmp")"   # $(<) strips trailing newline; assignment keeps it raw
  rm -f "$tmp"
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# Ctrl+O → y (yazi), landing the shell in whatever directory yazi exits from.
# Bound after deja loads (see dot-zshrc). The line you were typing survives.
_yazi_jump() {
	zle -I
	y
	zle reset-prompt
}

# Down opens completion, except on a bare `cd`, where it opens yazi instead.
# yazi already lands the shell in the directory it exits from, so the `cd` that
# called it has nothing left to run — the line is cleared before the jump.
_down_complete_or_yazi() {
	if [[ "${BUFFER// /}" == cd && $CURSOR == $#BUFFER ]]; then
		BUFFER=
		_yazi_jump
	elif (( ${+widgets[fzf-tab-complete]} )); then
		zle fzf-tab-complete
	else
		zle expand-or-complete
	fi
}

# claudex — launch claude. Subcommands: `claudex pick` opens fzf agent picker.
# Default (no subcommand): starts general claude.
# Runs claude in the current terminal. herdr is started by hand, not from here.
claudex() {
  local subcmd=$1
  if [[ "$subcmd" == "pick" ]]; then
    shift
    _claudex_pick "$@"
    return
  fi
  _claudex_run general "$@"
}

# _claudex_pick — fzf agent picker, then run the chosen agent.
_claudex_pick() {
  local choice
  command -v fzf >/dev/null 2>&1 || { echo "fzf required" >&2; return 1; }
  choice=$(printf 'general\narchitector\nimplementer\nskills\n' | fzf --prompt 'claude agent> ' --height 40%) || return 0
  _claudex_run "${choice:-general}" "$@"
}

# _claudex_run <agent-choice> [claude-args…] — build claude's arguments and run it.
# Each agent also picks its output style (~/.claude/output-styles, keyed by the file's
# frontmatter `name`). claude has no --output-style flag, so it rides in --settings JSON,
# which merges over the settings files.
# _claudex_model <agent-choice> [claude-args…] — echo the model the run will use.
# The agent's own default loses to an explicit --model on the command line, which is
# claude's own precedence. Prints nothing when neither names one, leaving claude's default.
_claudex_model() {
  local choice=$1; shift
  local model
  case "$choice" in
    implementer) model=sonnet ;;
  esac
  while (( $# )); do
    case "$1" in
      --model) model=$2; shift ;;
      --model=*) model=${1#--model=} ;;
    esac
    shift
  done
  printf '%s' "$model"
}

# _claudex_run <agent-choice> [claude-args…] — build claude's arguments and run it.
# Each agent also picks its output style (~/.claude/output-styles, keyed by the file's
# frontmatter `name`). claude has no --output-style flag, so it rides in --settings JSON,
# which merges over the settings files.
# ~/.claude/SYSTEM_PROMPT.md replaces the default prompt via --system-prompt: this
# claude has no --system-prompt-file flag, so the file is read into the argument.
# Its {{model}}, {{modelDescription}}, and {{currentDateTime}} placeholders are filled
# here — the prompt is a plain string to claude, which expands nothing.
_claudex_run() {
  local choice=$1; shift
  local -a args sysprompt
  local sysprompt_file=~/.claude/SYSTEM_PROMPT.md
  local model name description
  model=$(_claudex_model "$choice" "$@")
  case "$model" in
    sonnet*) name='Claude Sonnet 5'; description='Claude Sonnet 5 is a smart, efficient model for everyday use.' ;;
    haiku*)  name='Claude Haiku 4.5'; description='Claude Haiku 4.5 is the fastest model, for quick focused tasks.' ;;
    fable*)  name='Claude Fable 5'; description='Claude Fable 5 is a model for creative and open-ended work.' ;;
    *)       name='Claude Opus 5'; description='Claude Opus 5 is a powerful model for complex challenges.' ;;
  esac
  if [[ -r "$sysprompt_file" ]]; then
    sysprompt=(--system-prompt "$(sed \
      -e "s|{{model}}|$name|g" \
      -e "s|{{modelDescription}}|$description|g" \
      -e "s|{{currentDateTime}}|$(date '+%Y-%m-%d')|g" \
      "$sysprompt_file")")
  fi
  local -a modelflag
  [[ -n "$model" ]] && modelflag=(--model "$model")
  case "$choice" in
    architector) args=("${sysprompt[@]}" "${modelflag[@]}" --agent wm:architector --settings '{"outputStyle":"ARCHITECT"}' "$@") ;;
    implementer) args=("${sysprompt[@]}" "${modelflag[@]}" --agent wm:implementer --settings '{"outputStyle":"CODE"}' "$@") ;;
    skills) args=("${sysprompt[@]}" "${modelflag[@]}" --agent skill-builder) ;;
    general|"")  args=("${sysprompt[@]}" "${modelflag[@]}" "$@") ;;
  esac
  claude "${args[@]}"
}

# tw — pick a todo.sh action with fzf, pick the task too if it needs ITEM#, then run it.
tw() {
  local action
  action=$(todo.sh shorthelp | grep -oE '^    [a-z]+' | tr -d ' ' \
    | fzf --prompt 'todo> ' --height 40%) || return
  [[ -z "$action" ]] && return 0
  # actions that take an ITEM# as first arg → let you pick the task
  case "$action" in
    append|del|depri|done|move|prepend|pri|replace)
      local line item
      line=$(todo.sh -p ls | grep -E '^[0-9]+ ' | fzf --prompt "$action> " --height 60%) || return
      [[ -z "$line" ]] && return 0
      item="${line%% *}"
      todo.sh "$action" "$item" "$@"
      ;;
    *)
      todo.sh "$action" "$@"
      ;;
  esac
}

# diffx — fzf-pick the local working-tree diff or an open PR, open the `lumen diff` TUI to review + annotate,
# press `s` (Exit & send annotations to stdout) to write your feedback to a claude tmp file; print its path.
# lumen draws the TUI to /dev/tty when stdout is captured, reserving stdout for the annotation payload.
diffx() {
  local choice pr out
  print -u2 "diffx: picking…"
  choice=$({ echo "local  (working-tree diff, no PR)"; gh pr list --limit 100; } | fzf --prompt 'diff> ' --height 40%) || return
  [[ -z "$choice" ]] && return 0
  print -u2 "diffx: picked '$choice' — launching lumen (quit with s to save, q to discard)…"
  if [[ "$choice" == local* ]]; then
    out=$(mktemp "${TMPDIR:-/tmp}/claude-diffx-local.XXXXXX")
    lumen diff >"$out"
  else
    pr=$(echo "$choice" | grep -oE '[0-9]+' | head -1)   # first number on the line = PR#
    [[ -z "$pr" ]] && return 0
    out=$(mktemp "${TMPDIR:-/tmp}/claude-diffx-pr${pr}.XXXXXX")
    lumen diff --pr "$pr" >"$out"
  fi
  print -u2 "diffx: lumen exited"
  echo "$out"
}
