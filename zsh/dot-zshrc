

# Package manager prefix (nanobrew or homebrew)
if [[ -x /opt/nanobrew/prefix/bin/nb ]]; then
  export BREW_PREFIX=/opt/nanobrew/prefix
  export PATH="$BREW_PREFIX/bin:$PATH"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  export BREW_PREFIX="$(command brew --prefix)"  # 'command' bypasses the brew=nb alias on re-source
fi

# Extra completions from brew
FPATH=$FPATH:$BREW_PREFIX/share/zsh-completions

setopt AUTO_PUSHD                  # pushes the old directory onto the stack
setopt PUSHD_MINUS                 # exchange the meanings of '+' and '-'
setopt CDABLE_VARS                 # expand the expression (allows 'cd -2/tmp')


if secret="$(security find-generic-password -s CURSOR -w 2>/dev/null)"; then
  export CURSOR_API_KEY="$secret"
fi
unset secret

autoload -Uz add-zsh-hook
autoload -Uz compinit && compinit -i
zstyle ':completion:*' special-dirs true
# Tab opens a menu the arrow keys walk, instead of printing a list and dropping
# you back on the prompt with nothing selected.
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
# Without these two, a list taller than the screen makes zsh stop and ask "do you
# wish to see all 290 possibilities (184 lines)?". Setting them replaces that
# question with a scrollable page you walk with the arrow keys.
zstyle ':completion:*' list-prompt '%S-- %p -- arrows scroll, q quits --%s'
zstyle ':completion:*' select-prompt '%S-- %p --%s'
setopt LIST_PACKED



# --- zinit + OMZ snippets ---
# Loaded here (before the ~/.zshrc_* satellites) so user aliases win.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
source "${ZINIT_HOME}/zinit.zsh"

zinit snippet OMZL::git.zsh                 # git aliases and functions
zinit snippet OMZL::directories.zsh         # .. / ... / take (mkdir + cd)
zinit snippet OMZL::theme-and-appearance.zsh  # ls colors, terminal title
zinit snippet OMZP::git                      # 150+ git aliases (gst, gco, gp, ...)
zinit snippet OMZP::brew                     # Homebrew completions
zinit snippet OMZP::eza                      # eza aliases + completions
# dropped: OMZL::async_prompt (starship owns the prompt), OMZP::direnv (hooked in .zshrc_aliases)
# deja: do not also zinit-light it — that double-sources init.zsh and
# recurses _deja_line_init into FUNCNEST. Loaded once at the bottom.

eval "$(mise activate)"
eval "$(atuin init zsh --disable-up-arrow)"
source <(sk --shell zsh)
eval "$(sg completions)"

# Argument completion for the ~1000 CLIs carapace knows, most of which ship no
# zsh completion of their own. Registers via compdef, so it has to follow the
# compinit call above.
source <(carapace _carapace zsh)
# Use Apple clang for CGO (nanobrew LLVM lacks macOS SDK sysroot)
export CC=/usr/bin/clang

# Corp TLS: combined cert bundle (system + corp proxy certs)
export NODE_EXTRA_CA_CERTS="$HOME/.config/ssl/combined-certs.pem"

export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:$HOME/.cargo/bin
export PATH=$PATH:"$(go env GOPATH)/bin"
export PATH=$PATH:~/local/bin
export PATH=$PATH:/opt/nanobrew/prefix/bin


export EDITOR=hx
# if [[ $ZED_TERM == true ]]; then
  # export EDITOR="zed --wait"
  # export VISUAL="zed --wait"
# fi
autoload -z edit-command-line
function edit-command-line-trim() {
  edit-command-line
  BUFFER="${BUFFER%%$'\n'}"
}
zle -N edit-command-line-trim
bindkey '^G' edit-command-line-trim

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

get_keychain_secret() {
  security find-generic-password -s "$1" -a "$USER" -w 2>/dev/null
}

if secret="$(get_keychain_secret OPENROUTER_API_KEY)"; then
  export OPENROUTER_API_KEY="$secret"
fi
unset secret

# Source satellite configs
for f in ~/.zshrc_*; do
  [[ -f "$f" ]] && source "$f"
done


# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

export PATH="$HOME/.local/bin:$PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/vitaliipopov/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/vitaliipopov/Downloads/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/vitaliipopov/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/vitaliipopov/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

# Added by GitButler installer
eval "$(but completions zsh)"

# On the prompt, Tab and Shift+Tab both drive deja. Tab is deja's own default
# key; Shift+Tab is added after the source, where deja's per-prompt re-bind of
# its own keys will leave it alone. With no ghost showing, deja's cycle falls
# through to whatever ^I held when it loaded — the completion widget.
if [[ -r "$HOME/.local/share/deja/init.zsh" ]]; then source "$HOME/.local/share/deja/init.zsh"; else eval "$(deja init zsh)"; fi
bindkey '^[[Z' deja-cycle

# Down opens completion, and must be bound to the completion widget itself, not
# to a wrapper: zsh silently completes nothing when the widget on the key is
# user-defined. Costs the old next-history-line; atuin owns history anyway.
bindkey '^[[B' expand-or-complete
# Inside an open menu the arrows move the selection. Tab and Shift+Tab step
# forward and back through the matches — complist leaves ^I on complete-word
# there, which does not move the highlight at all.
bindkey -M menuselect '^I' menu-complete
bindkey -M menuselect '^[[Z' reverse-menu-complete

# yazi used to hang off cd<Tab>, but Tab can no longer share: zsh refuses to run
# the completion widget from inside a user-defined widget — it completes nothing,
# silently — so anything bound to Tab must be the completion widget itself. It
# moved to Ctrl+O, displacing accept-line-and-down-history.
if (( ${+functions[_yazi_jump]} )); then
  DEJA_IGNORE_WIDGETS+=(yazi-jump)
  zle -N yazi-jump _yazi_jump
  bindkey '^O' yazi-jump
fi

