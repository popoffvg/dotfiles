

# Package manager prefix (nanobrew or homebrew)
if [[ -x /opt/nanobrew/prefix/bin/nb ]]; then
  export BREW_PREFIX=/opt/nanobrew/prefix
  export PATH="$BREW_PREFIX/bin:$PATH"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  export BREW_PREFIX="$(command brew --prefix)"  # 'command' bypasses the brew=nb alias on re-source
fi

# Extra completions from brew
FPATH=$FPATH:$BREW_PREFIX/share/zsh-completions

setopt AUTO_PUSHD                  # pushes the old directory onto the stack
setopt PUSHD_MINUS                 # exchange the meanings of '+' and '-'
setopt CDABLE_VARS                 # expand the expression (allows 'cd -2/tmp')


if secret="$(security find-generic-password -s CURSOR -w 2>/dev/null)"; then
  export CURSOR_API_KEY="$secret"
fi
unset secret

autoload -Uz add-zsh-hook
autoload -Uz compinit && compinit -i
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' group-name ''
# No color escapes: fzf-tab ignores them. '[%d]' is what enables group headers.
zstyle ':completion:*:descriptions' format '[%d]'
# Fish-style help column: option lists include the description after `--`.
zstyle ':completion:*' verbose yes
zstyle ':completion:*:options' description yes
zstyle ':completion:*:options' auto-description '%d'
# fzf-tab needs the native menu off so it can capture the unambiguous prefix.
zstyle ':completion:*' menu no
setopt LIST_PACKED



# --- zinit + OMZ snippets ---
# Loaded here (before the ~/.zshrc_* satellites) so user aliases win.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
source "${ZINIT_HOME}/zinit.zsh"

zinit snippet OMZL::git.zsh                 # git aliases and functions
zinit snippet OMZL::directories.zsh         # .. / ... / take (mkdir + cd)
zinit snippet OMZL::theme-and-appearance.zsh  # ls colors, terminal title
zinit snippet OMZP::git                      # 150+ git aliases (gst, gco, gp, ...)
zinit snippet OMZP::brew                     # Homebrew completions
zinit snippet OMZP::eza                      # eza aliases + completions
# dropped: OMZL::async_prompt (starship owns the prompt), OMZP::direnv (hooked in .zshrc_aliases)
# deja: do not also zinit-light it — that double-sources init.zsh and
# recurses _deja_line_init into FUNCNEST. Loaded once at the bottom.

eval "$(mise activate)"
eval "$(atuin init zsh --disable-up-arrow)"
source <(sk --shell zsh)
eval "$(sg completions zsh)"

# Argument completion for the ~1000 CLIs carapace knows, most of which ship no
# zsh completion of their own. Registers via compdef, so it has to follow the
# compinit call above.
source <(carapace _carapace zsh)
# Use Apple clang for CGO (nanobrew LLVM lacks macOS SDK sysroot)
export CC=/usr/bin/clang

# Corp TLS: combined cert bundle (system + corp proxy certs). Only on a machine
# that has one - Node prints a warning on every start if the file is missing.
[[ -r "$HOME/.config/ssl/combined-certs.pem" ]] && export NODE_EXTRA_CA_CERTS="$HOME/.config/ssl/combined-certs.pem"

export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:$HOME/.cargo/bin
export PATH=$PATH:"$(go env GOPATH)/bin"
export PATH=$PATH:~/local/bin
export PATH=$PATH:/opt/nanobrew/prefix/bin


export EDITOR=hx
# if [[ $ZED_TERM == true ]]; then
  # export EDITOR="zed --wait"
  # export VISUAL="zed --wait"
# fi
autoload -z edit-command-line
function edit-command-line-trim() {
  edit-command-line
  BUFFER="${BUFFER%%$'\n'}"
}
zle -N edit-command-line-trim
bindkey '^G' edit-command-line-trim

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

get_keychain_secret() {
  security find-generic-password -s "$1" -a "$USER" -w 2>/dev/null
}

if secret="$(get_keychain_secret OPENROUTER_API_KEY)"; then
  export OPENROUTER_API_KEY="$secret"
fi
unset secret

# Source satellite configs
for f in ~/.zshrc_*; do
  [[ -f "$f" ]] && source "$f"
done


# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

export PATH="$HOME/.local/bin:$PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/vitaliipopov/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/vitaliipopov/Downloads/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/vitaliipopov/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/vitaliipopov/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

# Added by GitButler installer
eval "$(but completions zsh)"

# carapace's git completer is not captured by fzf-tab (empty picker). Native
# _git is. `g` has no completer of its own; carapace looks up $words[1] as `g`
# and returns nothing. Point both at _git after carapace and after `alias g=git`.
compdef _git git
compdef g=git
zstyle ':completion:*:git-checkout:*' sort false

# fzf-tab after every completer (carapace, gcloud, but) and before deja, which
# wraps widgets. It steals Tab; deja reclaims it below. Down is rebound to
# fzf-tab-complete after deja so the picker is the extra key, not deja's.
_fzf_tab=
for _fzf_tab_prefix in ${BREW_PREFIX:-} /opt/homebrew /opt/nanobrew/prefix; do
  [[ -r "$_fzf_tab_prefix/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh" ]] && {
    _fzf_tab="$_fzf_tab_prefix/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"
    break
  }
done
if [[ -n "$_fzf_tab" ]]; then
  source "$_fzf_tab"
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
fi
unset _fzf_tab _fzf_tab_prefix

# On the prompt, Tab and Shift+Tab both drive deja. Tab is deja's own default
# key; Shift+Tab is added after the source, where deja's per-prompt re-bind of
# its own keys will leave it alone. With no ghost showing, deja's cycle falls
# through to whatever ^I held when it loaded — the completion widget.
if [[ -r "$HOME/.local/share/deja/init.zsh" ]]; then source "$HOME/.local/share/deja/init.zsh"; else eval "$(deja init zsh)"; fi
bindkey '^[[Z' deja-cycle
# deja wraps every user widget at source time, then we ignore these so precmd
# will not wrap them again. Restore the unwrapped fzf-tab widgets or Down is a
# deja-modify wrapper and the picker stays empty.
if (( ${+widgets[fzf-tab-complete]} )); then
  DEJA_IGNORE_WIDGETS+=(fzf-tab-complete fzf-tab-dummy fzf-tab-debug)
  local _dj_prefix="${DEJA_ORIGINAL_WIDGET_PREFIX:-deja-orig-}" _dj_w _dj_orig
  for _dj_w in fzf-tab-complete fzf-tab-dummy fzf-tab-debug; do
    for _dj_orig in ${(k)widgets[(I)${_dj_prefix}*-${_dj_w}]}; do
      zle -A "$_dj_orig" "$_dj_w"
    done
  done
  unset _dj_prefix _dj_w _dj_orig
fi

# Down opens fzf-tab (fuzzy list + descriptions). fzf-tab-complete is a user
# widget that calls the orig completion widget internally, so it is allowed
# to complete — unlike a homegrown wrapper around expand-or-complete.
if (( ${+widgets[fzf-tab-complete]} )); then
  bindkey '^[[B' fzf-tab-complete
  bindkey '^[OB' fzf-tab-complete
else
  # Down opens completion. Costs the old next-history-line; atuin owns history
  # anyway. A user-defined widget on this key completes nothing until deja is told
  # to leave it alone — see the yazi block below, which rebinds the key.
  bindkey '^[[B' expand-or-complete
  bindkey '^[OB' expand-or-complete
fi

# Inside an open menu the arrows move the selection. Tab and Shift+Tab step
# forward and back through the matches — complist leaves ^I on complete-word
# there, which does not move the highlight at all.
#
# complist owns the menuselect keymap and loads itself only when a menu first
# opens. Without this load the keymap does not exist yet and both binds fail.
zmodload zsh/complist
bindkey -M menuselect '^I' menu-complete
bindkey -M menuselect '^[[Z' reverse-menu-complete

# yazi answers on Ctrl+O anywhere, and on Down when the line holds nothing but
# `cd` — the completion a bare `cd` would open lists the same directories yazi
# browses. Tab cannot share: deja owns it, and the key it re-binds every prompt
# must be the completion widget itself.
#
# Both widgets go in DEJA_IGNORE_WIDGETS. deja wraps every widget in the table
# on every precmd, and its wrapper is what makes a user-defined widget on Down
# complete nothing.
if (( ${+functions[_yazi_jump]} )); then
  DEJA_IGNORE_WIDGETS+=(yazi-jump down-complete-or-yazi)
  zle -N yazi-jump _yazi_jump
  bindkey '^O' yazi-jump

  zle -N down-complete-or-yazi _down_complete_or_yazi
  bindkey '^[[B' down-complete-or-yazi
fi

