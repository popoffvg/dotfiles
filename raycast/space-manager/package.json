{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "space-manager",
  "title": "Space Manager",
  "description": "Manage macOS Spaces via Hammerspoon \u2014 list, create, rename, switch",
  "icon": "command-icon.png",
  "author": "popoffvg",
  "license": "MIT",
  "commands": [
    {
      "name": "list-spaces",
      "title": "Spaces",
      "description": "Show all macOS spaces with names, switch or rename",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.1",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
