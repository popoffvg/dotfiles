<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vitalii.gui-path</string>
  <!-- GUI apps start with PATH=/usr/bin:/bin:/usr/sbin:/sbin. Zed runs rustc from this PATH to compile a dev extension. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>launchctl setenv PATH "$HOME/.cargo/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
