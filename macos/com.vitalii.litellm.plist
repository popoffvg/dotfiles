<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vitalii.litellm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -eu; umask 077; set -a; . "$HOME/.config/litellm/.env"; set +a; exec "$HOME/.local/bin/litellm" --config "$HOME/.config/litellm/config.yaml" --host 127.0.0.1 --port 4000 --num_workers 1 &gt;&gt;"$HOME/Library/Logs/litellm.log" 2&gt;&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
